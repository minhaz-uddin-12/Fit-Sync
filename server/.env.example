# Port the API listens on locally
PORT=5000

# PostgreSQL connection string (Neon: use the "Pooled connection" string).
# Leave empty in development to use the embedded database in server/.data/pglite.
DATABASE_URL=

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Production only: credentials for the accounts created by `npm run db:migrate`
ADMIN_EMAIL=admin@fitsync.com
ADMIN_PASSWORD=
TRAINER_PASSWORD=

# development | production
NODE_ENV=development
